# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical production origin, no trailing slash. Used for canonical URLs,
# hreflang, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://bac-dz-iota.vercel.app

# Public contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=Arthur_exe@proton.me

# ---------------------------------------------------------------------------
# Database (optional but required for the admin CMS + analytics)
# ---------------------------------------------------------------------------
# Neon / Supabase Postgres pooled connection string.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------
# Long random password for /admin. Generate: openssl rand -base64 24
ADMIN_PASSWORD=
# At least 32 random characters, used to sign the session cookie.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Monetization (disabled until a real publisher ID exists)
# ---------------------------------------------------------------------------
# Leave empty to disable all ad slots. Never commit a real ID.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---------------------------------------------------------------------------
# Analytics (optional, privacy-first)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_CLARITY_ID=
